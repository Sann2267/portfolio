# Copy to .env for local overrides (the app also reads real environment variables).
# development | testing | production
APP_ENV=development

# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Public origin used for canonical URLs, Open Graph, and the sitemap. If empty in production the
# app uses VERCEL_PROJECT_PRODUCTION_URL, or the host of the first request, and logs a warning.
SITE_URL=http://127.0.0.1:5000

# Optional: point the app at another content directory.
# CONTENT_DIR=./content
