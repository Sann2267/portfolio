# Copy to .env for local overrides (the app also reads real environment variables).
# development | testing | production
APP_ENV=development

# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Public origin used for canonical URLs, Open Graph, and the sitemap. Required in production
# unless the app runs on Vercel, where VERCEL_PROJECT_PRODUCTION_URL is used when this is empty.
SITE_URL=http://127.0.0.1:5000

# Optional: point the app at another content directory.
# CONTENT_DIR=./content
